{
  "id": "api-v1-to-v2-translator",
  "aliases": ["v1-to-v2-api", "api-v2"],
  "name": "REST API v1 to v2 Schema Translator",
  "version": "1.0.0",
  "target_kind": "http-proxy",
  "description": "Renames legacy snake_case v1 API fields to camelCase v2 contracts, drops deprecated debug fields, and injects apiVersion metadata.",
  "author": "morph-os-core",
  "fail_policy": "fail-open",
  "output_format": "json",
  "rules": [
    {
      "op": "parse_json"
    },
    {
      "op": "rename_fields",
      "mappings": {
        "usr_id": "userId",
        "usr_name": "displayName",
        "acct_bal_cents": "balanceCents",
        "created_dt": "createdAt",
        "is_actv": "isActive"
      },
      "case_style": "camel_case",
      "drop_fields": ["legacy_debug_flag", "internal_row_ver"],
      "add_fields": {
        "apiVersion": "v2"
      }
    }
  ],
  "llm_prompt": "Migrate this legacy v1 JSON API payload to v2 camelCase schema, renaming usr_id->userId, usr_name->displayName, acct_bal_cents->balanceCents, created_dt->createdAt, is_actv->isActive, and dropping legacy_debug_flag. Output ONLY valid JSON.",
  "rust_hook_template": "pub fn mutate_v1_to_v2(val: &serde_json::Value) -> serde_json::Value {\n    morph_core::ollama::rename_json_fields(val, &Default::default(), Some(morph_core::ollama::CaseStyle::CamelCase), &[], &Default::default())\n}",
  "sample_input": "{\n  \"usr_id\": \"u_88412\",\n  \"usr_name\": \"Ada Lovelace\",\n  \"acct_bal_cents\": 145090,\n  \"created_dt\": \"2024-03-18T11:20:00Z\",\n  \"is_actv\": true,\n  \"billing_tier\": \"enterprise\",\n  \"legacy_debug_flag\": 1\n}"
}
